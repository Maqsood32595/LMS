# ============================================================
# Fractal LMS — Example Environment (copy to .env and fill in)
# ============================================================

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# --- Supabase PostgreSQL (password must be URL-encoded: @ -> %40) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD%40ENCODED@db.YOURPROJECT.supabase.co:5432/postgres

# --- Google Cloud Storage ---
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=./server/config/gcs-service-account.json
GOOGLE_CLOUD_BUCKET_NAME=your-bucket
GCS_PREFIX=fractal-lms/
GCS_KEY_BASE64=
SIGNED_URL_TTL_SECONDS=3600

# --- JWT ---
JWT_SECRET=generate-a-64-char-hex-secret
JWT_REFRESH_SECRET=generate-another-64-char-hex-secret
JWT_EXPIRES_IN=7d

# --- Bootstrap Admin ---
ADMIN_EMAIL=admin@fractallms.app
ADMIN_PASSWORD=admin@123
ADMIN_FIRST_NAME=Fractal
ADMIN_LAST_NAME=Admin
